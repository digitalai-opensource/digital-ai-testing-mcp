{
  "name": "digital-ai-testing-mcp",
  "version": "2.0.6",
  "description": "MCP server for Digital.ai Testing — device farm, app lifecycle, test runs, reporting and analytics, performance, live mobile and browser inspection, and test authoring",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "digital.ai",
    "mobile-testing",
    "appium",
    "selenium",
    "device-farm",
    "test-automation"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "digital-ai-testing-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "resources/boilerplate",
    "resources/test-orchestrator"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalai-opensource/digital-ai-testing-mcp.git"
  },
  "homepage": "https://github.com/digitalai-opensource/digital-ai-testing-mcp#readme",
  "bugs": "https://github.com/digitalai-opensource/digital-ai-testing-mcp/issues",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:offline": "vitest run --project offline",
    "test:api": "vitest run --project api",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:users": "vitest run tests/api/users.test.ts",
    "test:devices": "vitest run tests/api/devices.test.ts",
    "test:device-groups": "vitest run tests/api/device-groups.test.ts",
    "test:reservations": "vitest run tests/api/reservations.test.ts",
    "test:applications": "vitest run tests/api/applications.test.ts",
    "test:application-tools": "vitest run tests/application-tools.test.ts",
    "test:repository": "vitest run tests/api/repository.test.ts",
    "test:browsers": "vitest run tests/api/browsers.test.ts",
    "test:projects": "vitest run tests/api/projects.test.ts",
    "test:provisioning": "vitest run tests/api/provisioning-profiles.test.ts",
    "test:health": "vitest run tests/api/health.test.ts",
    "test:utils": "vitest run tests/utils.test.ts",
    "test:reporting": "vitest run tests/api/reporting.test.ts",
    "test:reporting-tools": "vitest run tests/reporting-tools.test.ts",
    "test:transaction-tools": "vitest run tests/transaction-tools.test.ts",
    "test:browser-tools": "vitest run tests/browser-tools.test.ts",
    "test:web-inspection": "vitest run tests/web-inspection.test.ts",
    "test:test-view-tools": "vitest run tests/test-view-tools.test.ts",
    "test:environment-tools": "vitest run tests/environment-tools.test.ts",
    "test:video": "vitest run tests/test-video.test.ts",
    "test:maestro": "vitest run tests/maestro-flow.test.ts",
    "test:find-elements": "vitest run tests/find-elements.test.ts",
    "test:remediation": "vitest run tests/remediation.test.ts",
    "test:tool-catalog": "vitest run tests/tool-catalog.test.ts",
    "test:appium3-gestures": "vitest run tests/appium3-gestures.test.ts",
    "test:examples-doc": "vitest run tests/examples-doc.test.ts",
    "test:test-views": "vitest run tests/api/test-views.test.ts",
    "test:transactions": "vitest run tests/api/transactions.test.ts",
    "test:analytics": "vitest run tests/api/analytics.test.ts",
    "test:infrastructure": "vitest run tests/api/infrastructure.test.ts",
    "test:performance": "vitest run tests/performance.test.ts",
    "test:tools": "vitest run tests/tools.test.ts",
    "test:usage-reports": "vitest run tests/usage-reports.test.ts",
    "test:usage-report-tools": "vitest run tests/usage-report-tools.test.ts",
    "test:access-level": "vitest run tests/access-level.test.ts",
    "test:api-error": "vitest run tests/api-error.test.ts",
    "test:debug-tools": "vitest run tests/debug-tools.test.ts",
    "test:reporting-sort": "vitest run tests/reporting-sort.test.ts",
    "test:boilerplate-templates": "vitest run tests/boilerplate-templates.test.ts",
    "test:test-orchestrator": "vitest run tests/test-orchestrator.test.ts",
    "test:boilerplate-orchestration": "vitest run tests/boilerplate-orchestration.test.ts",
    "test:test-status": "vitest run tests/test-status.test.ts",
    "test:report-ref": "vitest run tests/report-ref.test.ts",
    "test:project-settings": "vitest run tests/project-settings.test.ts",
    "test:automotive": "vitest run tests/automotive.test.ts",
    "test:test-runs": "vitest run tests/test-runs.test.ts",
    "test:rca": "vitest run tests/rca.test.ts",
    "test:toolsets": "vitest run tests/toolsets.test.ts",
    "test:fidelity-score": "vitest run tests/fidelity-score.test.ts",
    "test:fidelity": "npm run build && tsx tests/fidelity/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.19.0",
    "dotenv": "^18.0.0",
    "form-data": "^4.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
