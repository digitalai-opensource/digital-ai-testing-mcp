*** Keywords ***
Wait And Click
    [Arguments]    ${locator}
    # Explicit wait before every interaction — AppiumLibrary's Click Element / Input Text do not wait on their own.
    Wait Until Element Is Visible    ${locator}    20s
    Click Element    ${locator}

Wait And Input
    [Arguments]    ${locator}    ${text}
    Wait Until Element Is Visible    ${locator}    20s
    Input Text    ${locator}    ${text}

# More AppiumLibrary keywords that fit a device farm (all built in, no extra library):
#   Expect Text    <text>    visible    timeout=20s      polling assertion (also Expect Element    <locator>    visible)
#   Scroll Element Into View    <locator>                 reach content below the fold
#   ${contexts}=    Get Contexts    /    Switch To Context    WEBVIEW_...    /    Switch To Context    NATIVE_APP   (hybrid screens)
#   Background Application    5                           lifecycle check

Open Cloud Session
    Open Application    ${REMOTE_URL}    &{CAPABILITIES}

Close Cloud Session
    # Report the real outcome: without this a failed step or assertion can still show as Passed in the platform report.
    Run Keyword And Ignore Error    Report Test Outcome    ${TEST STATUS}    ${TEST MESSAGE}
    ${url}=    Run Keyword And Ignore Error    Get Capability    digitalai:reportUrl
    Log To Console    \nReport URL: ${url}[1]
    Close Application
