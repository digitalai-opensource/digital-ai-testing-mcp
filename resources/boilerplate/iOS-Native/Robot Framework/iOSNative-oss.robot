*** Settings ***
Documentation     Digital.ai Testing — iOS native test (Appium Server project), generated by the Digital.ai Testing MCP.
...               Run:  pip install -r requirements.txt  then  robot tests/iOSNative.robot
Library           AppiumLibrary    timeout=10
Library           DigitalAiReport.py
Test Setup        Open Cloud Session
Test Teardown     Close Cloud Session

*** Variables ***
${REMOTE_URL}       [Enter Instance here]/wd/hub
# The DIGITAL_AI_ACCESS_KEY environment variable wins; the value after "=" is the fallback. Remove the fallback before committing.
${ACCESS_KEY}       %{DIGITAL_AI_ACCESS_KEY=[Enter Your Access key here]}
${TEST_NAME}        [Enter Test Name here]
&{CAPABILITIES}     platformName=iOS
...                 appium:automationName=XCUITest
...                 digitalai:accessKey=${ACCESS_KEY}
...                 digitalai:testName=${TEST_NAME}
...                 digitalai:deviceQuery=@os='ios' and @category='[Enter PHONE/TABLET here]'
...                 appium:app=cloud:com.experitest.ExperiBank
...                 appium:bundleId=com.experitest.ExperiBank

*** Test Cases ***
Quick Start iOS Native Demo
    Start Steps Group    Test steps
    # [BEGIN_DEMO_STEPS]
    Wait And Input    accessibility_id=usernameTextField    company
    Wait And Input    accessibility_id=passwordTextField    company
    Wait And Click    accessibility_id=loginButton
    Wait And Click    accessibility_id=makePaymentButton
    Wait And Input    accessibility_id=phoneTextField    1234567
    Wait And Input    accessibility_id=nameTextField    Jon Snow
    Wait And Input    accessibility_id=amountTextField    50
    Wait And Click    accessibility_id=countryButton
    Wait And Click    accessibility_id=Switzerland
    Wait And Click    accessibility_id=sendPaymentButton
    Wait And Click    accessibility_id=Yes
    # [END_DEMO_STEPS]
    Stop Steps Group

*** Keywords ***
Wait And Click
    [Arguments]    ${locator}
    # Explicit wait before every interaction — AppiumLibrary's Click Element / Input Text do not wait on their own.
    Wait Until Element Is Visible    ${locator}    20s
    Click Element    ${locator}

Wait And Input
    [Arguments]    ${locator}    ${text}
    Wait Until Element Is Visible    ${locator}    20s
    Input Text    ${locator}    ${text}

Open Cloud Session
    Open Application    ${REMOTE_URL}    &{CAPABILITIES}

Close Cloud Session
    # Report the real outcome: without this a failed step or assertion can still show as Passed in the platform report.
    Run Keyword And Ignore Error    Report Test Outcome    ${TEST STATUS}    ${TEST MESSAGE}
    ${url}=    Run Keyword And Ignore Error    Get Capability    digitalai:reportUrl
    Log To Console    \nReport URL: ${url}[1]
    Close Application
