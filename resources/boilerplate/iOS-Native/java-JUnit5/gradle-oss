apply plugin: 'java'

// Standalone use only — remove if this module is part of a larger Gradle project
repositories { mavenCentral() }

// JUnit 5 runs on the JUnit Platform — without this Gradle finds ZERO tests and still reports success
test {
    useJUnitPlatform()
}

dependencies {
    testImplementation group: 'org.junit.jupiter', name: 'junit-jupiter', version: '5.10.2'
    testRuntimeOnly group: 'org.junit.platform', name: 'junit-platform-launcher', version: '1.10.2'
    // java-client 11 depends on selenium-api only ([4.50.0, 5.0)) and Gradle resolves the LOWEST version in a range —
    // selenium-java pins the drivers and support classes explicitly
    testImplementation group: 'io.appium', name: 'java-client', version: '11.0.0'
    testImplementation group: 'org.seleniumhq.selenium', name: 'selenium-java', version: '4.51.0'
}
