# ============================================================
# Digital.ai Testing — MCP Server Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# Required: Default connection (active on startup)
DIGITAL_AI_BASE_URL=https://your-tenant.experitest.com
DIGITAL_AI_ACCESS_KEY=your_access_key_here

# MCP Server identity (shown in AI tool picker)
MCP_SERVER_NAME=digital-ai-testing-mcp
# Version is read from package.json automatically. Set only to override (rarely needed).
# MCP_SERVER_VERSION=

# Timeouts in milliseconds
REQUEST_TIMEOUT_MS=30000
UPLOAD_TIMEOUT_MS=120000

# Optional: load only some toolsets in full to reduce context size (default: all).
# Other tools stay listed and load themselves on first call. See README "Toolsets".
# MCP_TOOLSETS=reporting,inspection,authoring

# Optional: debug mode for improving this MCP (default: false — no behaviour change).
# true = the server logs its own tool-call events and asks the client agent to record remediation
# notes (errors, unclear guidance, user corrections, gave-up, better paths, improvements) in
# a remediation/ folder in the root of the project the agent is working in (it ignores itself in git).
# Under Docker the notes are returned to the agent to save there. MCP_REMEDIATION_DIR overrides the folder.
# See README "Debug mode".
MCP_DEBUG_MODE=false

# Optional: Deque Axe DevTools Mobile API key
# Required when using includeAxeScan: true in get_test_boilerplate.
# Obtain from your Axe DevTools Mobile subscription at deque.com
# AXE_DEVTOOLS_API_KEY=your_axe_api_key_here

# ============================================================
# Named environments (optional)
#
# The most common use case is switching between projects on
# the same instance — for example, a Cloud Admin key for
# administration and one or more project-scoped API keys for
# day-to-day test work:
#
#   DAI_PROFILE_{NAME}_URL=https://...      (same URL as above is fine)
#   DAI_PROFILE_{NAME}_KEY=your_key_here
#
# Use list_environments to see all configured profiles and
# switch_environment("<name>") to switch between them without
# restarting. All subsequent tool calls use the new credentials
# immediately.
# ============================================================

# Example — switching between a Cloud Admin key and two project keys
# on the same instance (the most common setup):
#
# DAI_PROFILE_ADMIN_URL=https://your-tenant.experitest.com
# DAI_PROFILE_ADMIN_KEY=...your_cloud_admin_key...      (either key format; level is detected from the API)
#
# DAI_PROFILE_QA_URL=https://your-tenant.experitest.com
# DAI_PROFILE_QA_KEY=...your_qa_project_key...
#
# DAI_PROFILE_POC_URL=https://your-tenant.experitest.com
# DAI_PROFILE_POC_KEY=...your_poc_project_key...

# Example — switching between instances (less common):
#
# DAI_PROFILE_STAGING_URL=https://staging.experitest.com
# DAI_PROFILE_STAGING_KEY=your_staging_key_here
#
# DAI_PROFILE_EU_URL=https://eu.experitest.com
# DAI_PROFILE_EU_KEY=your_eu_key_here
